/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "ProcessMemoryViewer.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_PROCESSMEMORYVIEWER_DIALOG DIALOGEX 0, 0, 600, 450
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Process Memory Viewer"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Select Process:",IDC_STATIC,7,10,52,8
    COMBOBOX        IDC_PROCESS_COMBO,65,8,380,200,CBS_DROPDOWNLIST | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Refresh List",IDC_REFRESH_BTN,455,7,65,14
    PUSHBUTTON      "Open Process",IDC_OPEN_PROCESS_BTN,525,7,70,14
    LTEXT           "Process Information:",IDC_STATIC,7,30,70,8
    LTEXT           "Process ID: - | Memory Regions: -",IDC_PROCESS_INFO_STATIC,85,30,510,8
    GROUPBOX        "Memory Statistics",IDC_STATIC,7,45,588,40
    LTEXT           "Total Committed: -",IDC_TOTAL_MEMORY_STATIC,15,58,140,8
    LTEXT           "Private: -",IDC_PRIVATE_MEMORY_STATIC,165,58,140,8
    LTEXT           "Mapped: -",IDC_MAPPED_MEMORY_STATIC,315,58,130,8
    LTEXT           "Image: -",IDC_IMAGE_MEMORY_STATIC,455,58,135,8
    GROUPBOX        "Memory Regions",IDC_STATIC,7,90,588,353
    CONTROL         "",IDC_MEMORY_LIST,"SysListView32",LVS_REPORT | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,15,105,575,330
END


